{
  "name": "bxb-vercel-api",
  "version": "1.0.0",
  "private": true,
  "description": "Vercel serverless API for BxB calculator — proxies viewer save POSTs into GitHub PRs",
  "type": "module",
  "scripts": {
    "build:local": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "test": "node --test tests/unit/*.mjs",
    "test:ui": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,cjs,html,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,html,css,md}\""
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  }
}
